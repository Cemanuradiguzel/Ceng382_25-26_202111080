@page
@model RazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-4">
    <div class="row">
        <!-- Sol taraftaki form -->
        <div class="col-md-4">
            <h3>@(Model.EditId.HasValue ? "Edit Class" : "Add Class")</h3>
            <form method="post">
                <input type="hidden" asp-for="EditId" />
                <div class="form-group">
                    <label for="ClassName">Class Name</label>
                    <input type="text" asp-for="ClassName" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="StudentCount">Student Count</label>
                    <input type="number" asp-for="StudentCount" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="Description">Description</label>
                    <textarea asp-for="Description" class="form-control" required></textarea>
                </div>
                <button type="submit" asp-page-handler="AddOrEdit" class="btn btn-primary">
                    @(Model.EditId.HasValue ? "Save Changes" : "Add Class")
                </button>
            </form>
        </div>

        <!-- Sağ taraftaki tablo -->
        <div class="col-md-8">
            <h3>Class List</h3>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in IndexModel.Classes)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
