@page
@model MyRazorApp.Pages.EditModel
@{
    ViewData["Title"] = "Home page";
}

<h1>Edit Class Information</h1>

<form method="post">
    <input type="text" id="ClassName" name="ClassInfo.ClassName" class="form-control" value="@Model.ClassInfo.ClassName" required />
    <input type="number" id="StudentCount" name="ClassInfo.StudentCount" class="form-control" value="@Model.ClassInfo.StudentCount" required />
    <textarea id="Description" name="ClassInfo.Description" class="form-control" required>@Model.ClassInfo.Description</textarea>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

