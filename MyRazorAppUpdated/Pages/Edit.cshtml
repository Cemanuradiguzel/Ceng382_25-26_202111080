<form method="post">
    <h1>Edit Class Information</h1>

    <!-- Use asp-for for binding fields -->
    <div class="form-group">
        <label for="ClassName">Class Name</label>
        <input type="text" asp-for="ClassInfo.ClassName" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="StudentCount">Student Count</label>
        <input type="number" asp-for="ClassInfo.StudentCount" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="Description">Description</label>
        <textarea asp-for="ClassInfo.Description" class="form-control" required></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>