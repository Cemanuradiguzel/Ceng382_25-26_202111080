@page
@model RazorApp.Pages.EditModel
@{
    ViewData["Title"] = "Edit Class";
}

@if (!ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<form method="post">
    <h1>Edit Class Information</h1>

    <!-- Use asp-for for binding fields -->
    <div class="form-group">
        <label for="ClassName">Class Name</label>
        <input type="text" asp-for="ClassInfo.Name" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="StudentCount">Student Count</label>
        <input type="number" asp-for="ClassInfo.PersonCount" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="Description">Description</label>
        <textarea asp-for="ClassInfo.Description" class="form-control" required></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>