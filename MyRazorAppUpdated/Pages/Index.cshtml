@page
@model RazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-4">
    <div class="row">
        <!-- Add and Edit Class form -->
        <div class="col-md-4">
            <h3 class="text-center">@(Model.EditId.HasValue ? "Edit Class" : "Add Class")</h3>
            <div class="form-border"> <!-- Wrapper div for border -->
                <form method="post">
                    <input type="hidden" asp-for="EditId" />
                    <div class="form-group">
                        <label for="ClassName">Class Name</label>
                        <input type="text" asp-for="ClassName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label for="StudentCount">Student Count</label>
                        <input type="number" asp-for="StudentCount" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control" required></textarea>
                    </div>
                    <button type="submit" asp-page-handler="AddOrEdit" 
                        class="btn @(Model.EditId.HasValue ? "save-btn" : "btn-primary") button-spacing">
                        @(Model.EditId.HasValue ? "Save Changes" : "Add Class")
                    </button>
                </form>
            </div>
        </div>
    

        <!-- Class List -->
        <div class="col-md-8"> <!-- Buraya class eklendi -->
            <h3 class="text-center">Class List</h3>
            <div class="table-border"> <!-- Wrapper div for border -->                
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th style="width: 160px;">Actions</th> <!-- Adjust width -->
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in IndexModel.Classes)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <form method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <!-- Edit Button with Icon -->
                                        <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>

                                        <!-- Delete Button with Icon -->
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
