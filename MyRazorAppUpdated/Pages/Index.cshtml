@page
@model RazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

@using MyRazorApp.Models

@if (!ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<div class="container mt-4">
    <div class="row">
        <!-- Add and Edit Class form -->
        <div class="col-md-4">
            <h3 class="form-heading text-center">@(Model.EditId.HasValue ? "Edit Class" : "Add Class")</h3>
            <div class="form-border"> <!-- Wrapper div for border -->
                <form method="post">
                    <input type="hidden" asp-for="EditId" />
                    <div class="form-group">
                        <label for="ClassName">Class Name</label>
                        <input type="text" asp-for="ClassName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label for="StudentCount">Student Count</label>
                        <input type="number" asp-for="StudentCount" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control" required></textarea>
                    </div>
                    <button type="submit" asp-page-handler="AddOrEdit" 
                        class="btn @(Model.EditId.HasValue ? "save-btn" : "btn-primary") button-spacing">
                        @(Model.EditId.HasValue ? "Save Changes" : "Add Class")
                    </button>
                </form>
            </div>
        </div>
    
        <!-- Logout button -->
        <div class="col-md-8">
            <div class="d-flex justify-content-end mb-3">
            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="btn btn-danger btn-sm logout-btn">Logout</button>
            </form>
        </div>
        

        <!-- Class List -->
        <div class="col-md-8"> <!-- Buraya class eklendi -->
            <h3 class="text-center">Class List</h3>
            <div class="table-border"> <!-- Wrapper div for border -->
                <!-- Filter Form -->
                <form method="get">
                    <input type="text" name="filter" value="@Request.Query["filter"]" class="form-control" placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-primary mt-3">Filter</button>
                </form>        
                 <!-- JSON Export Button -->
                <form method="post" asp-page-handler="ExportJson" id="exportForm">
                    <input type="hidden" name="selectedColumns" id="selectedColumns" />
                    <input type="hidden" name="filter"      value="@Request.Query["filter"]" />
                    <input type="hidden" name="pageIndex"   value="@(ViewData["CurrentPage"] ?? 1)" />

                    <button type="button" class="btn btn-info" onclick="exportToJson()">
                        Export to JSON
                    </button>
                </form>
    
                <table class="table table-bordered mt-4">
                    <thead>
                        <tr>
                            <th class="column-header" data-column="ClassName" onclick="toggleColumnSelection(this)">Class Name</th>
                            <th class="column-header" data-column="StudentCount" onclick="toggleColumnSelection(this)">Student Count</th>
                            <th class="column-header" data-column="Description" onclick="toggleColumnSelection(this)">Description</th>
                            <th style="width: 160px;">Actions</th> <!-- Adjust width -->
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in (ViewData["ClassList"] as List<ClassInformationModel>) ?? new List<ClassInformationModel>())
                        {
                            <tr>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <form method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <!-- Edit Button with Icon -->
                                        <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>

                                        <!-- Delete Button with Icon -->
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                

                @{
                    int currentPage = (int)(ViewData["CurrentPage"] ?? 1); // Varsayılan olarak 1
                    int totalPages = (int)(ViewData["TotalPages"] ?? 1);   // Varsayılan olarak 1
                }
                <!-- Pagination Controls -->
                <div>
                    
                    <!-- Previous Button -->
                    <a href="?pageIndex=@(currentPage - 1)&filter=@Request.Query["filter"]" 
                        class="btn btn-secondary" @(currentPage <= 1 ? "disabled" : "")>
                        Previous
                    </a>

                    <!-- Page Information -->
                    <span>Page @currentPage of @totalPages</span>

                    <!-- Next Button -->
                    <a href="?pageIndex=@(currentPage + 1)&filter=@Request.Query["filter"]" 
                        class="btn btn-secondary" @(currentPage >= totalPages ? "disabled" : "")>
                        Next
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


    <script>
    let selectedColumns = [];

    document.querySelectorAll('.column-header').forEach(column => {
        column.addEventListener('click', () => {
            const name = column.dataset.column;
            const idx  = Array.from(column.parentElement.children)
                                .indexOf(column) + 1;
            if (selectedColumns.includes(name)) {
                selectedColumns = selectedColumns.filter(c => c !== name);
                column.classList.remove('selected');
                document.querySelectorAll(`td:nth-child(${idx})`)
                        .forEach(td => td.classList.remove('selected-column'));
            } else {
                selectedColumns.push(name);
                column.classList.add('selected');
                document.querySelectorAll(`td:nth-child(${idx})`)
                        .forEach(td => td.classList.add('selected-column'));
            }
        });
    });

    function exportToJson() {
        document.getElementById('selectedColumns').value = selectedColumns.join(',');
        document.getElementById('exportForm').submit();
    }

</script>
